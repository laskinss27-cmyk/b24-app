# Dedicated integration configuration. Never commit real values.
# Node.js 24+ is required when enabled. Existing backend defaults to off.
UMNIYDOM_ORDERS_MODE=off
# off | mock (sandbox only) | live (production only, after separate activation)
UMNIYDOM_ORDERS_PROCESSOR=off
UMNIYDOM_ORDERS_SECRET=
UMNIYDOM_ORDERS_SOURCE_ID=
# Set an absolute persistent path. Separate sandbox and production databases.
UMNIYDOM_ORDERS_DB=
UMNIYDOM_ORDERS_PORT=3091
UMNIYDOM_ORDERS_CHAT_ID=chat19572
PORTAL_DOMAIN=portal.example.bitrix24.ru
PUBLIC_BASE_URL=https://app.example.com
# Dedicated service account webhook: crm + im permissions, membership in the chat.
# Never fall back to an employee, administrator or unrelated webhook.
UMNIYDOM_ORDERS_CRM_WEBHOOK=
# Автозадачи, active user 2812, verified 2026-09-14. Old user 8 is inactive.
# Explicit assignment; no human fallback. Verify again on another portal.
UMNIYDOM_ORDERS_ROBOT_ID=2812
# Existing lead status confirmed on this portal. No guessed pipeline/stage.
UMNIYDOM_ORDERS_LEAD_STATUS=

# Read-only reverse order status. Enable only after coordinated storefront verification.
UMNIYDOM_ORDER_STATUS_MODE=off
# Use a dedicated bearer token; never expose it in logs or reports.
UMNIYDOM_ORDER_STATUS_SECRET=
# Container deployments may use UMNIYDOM_ORDER_STATUS_SECRET_FILE instead.
# Explicit CRM deal categories that represent an order lifecycle (verify before enabling).
UMNIYDOM_ORDER_STATUS_DEAL_CATEGORIES=0,6
