# Локальная разработка. Скопировать в packages/backend/.env или передать переменные процессу.
# Реальные токены и секреты не коммитить.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

PORTAL_DOMAIN=portal.example.bitrix24.ru
PUBLIC_BASE_URL=https://app.example.com

# Данные локального приложения Битрикс24.
APP_CLIENT_ID=
APP_CLIENT_SECRET=
APP_SECRET=

# Складское ядро. При запуске backend вне Docker укажите доступный адрес ERPNext.
ERPNEXT_URL=http://127.0.0.1:8080
ERPNEXT_TOKEN=

# Необязательные ссылки, добавляемые в задачи Битрикс24.
APP_SECTION_URL=
SUPPLY_SECTION_URL=
REPAIRS_SECTION_URL=

# Оповещения инвентаризации: off или on.
INVENTORY_NOTIFY=off

# Ответственный снабжения и склад прихода.
REPAIR_SUPPLY_RESPONSIBLE_ID=
SUPPLY_RECEIPT_STORE=Склад Прихода

# Только для служебных и исследовательских сценариев. Раскомментировать при необходимости.
# AUTOZADACHI_WEBHOOK=https://portal.example.bitrix24.ru/rest/...
# DEV_WEBHOOK=https://portal.example.bitrix24.ru/rest/...
