# Локальная разработка. Скопировать в packages/backend/.env или передать переменные процессу.
# Реальные токены и секреты не коммитить.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

PORTAL_DOMAIN=portal.example.bitrix24.ru
PUBLIC_BASE_URL=https://app.example.com

# Данные локального приложения Битрикс24.
APP_CLIENT_ID=
APP_CLIENT_SECRET=
APP_SECRET=

# Постоянный OAuth владельца выключен по умолчанию. При включении /install сохраняет
# refresh token зашифрованно в B24_STATE_DIR/oauth/owner.v1.enc.
B24_APP_OAUTH_VAULT=off
# Отдельный случайный секрет (минимум 32 символа) только для server-side диагностики.
# B24_APP_OPERATOR_TOKEN=

# Складское ядро. При запуске backend вне Docker укажите доступный адрес ERPNext.
ERPNEXT_URL=http://127.0.0.1:8080
ERPNEXT_TOKEN=

# Отдельная workflow-БД приложения. По умолчанию выключена и не меняет поведение.
# Включение readiness не запускает миграции и не переключает чтения/записи.
B24_APP_DB_MODE=off
B24_APP_CATALOG_SQL_READ=off
B24_APP_RESERVATIONS=off
# `shadow` читает проекцию тем же read-only пользователем. `active` требует
# отдельного DML-пользователя и включает API/overlay; миграции на старте не запускаются.
# B24_APP_RESERVATION_DB_USER=b24_app_reservation_runtime
# B24_APP_RESERVATION_DB_PASSWORD=
# B24_APP_RESERVATION_DB_CONNECTION_LIMIT=4
# B24_APP_DB_HOST=<проверенное DNS-имя в erpnext_frappe_network>
# B24_APP_DB_PORT=3306
# B24_APP_DB_NAME=b24_app
# B24_APP_DB_USER=b24_app_runtime
# B24_APP_DB_PASSWORD=
# B24_APP_DB_CONNECTION_LIMIT=4
# B24_APP_DB_CONNECT_TIMEOUT_MS=3000
# Per-request supply graph observation. `shadow` logs parity but keeps the
# Bitrix/ERPNext response authoritative; there is deliberately no SQL source mode yet.
B24_APP_SUPPLY_SQL_READ=off
# Только для ручного db:migrate; не хранить в постоянном env runtime-контейнера.
# B24_APP_MIGRATION_DB_USER=b24_app_migrator
# B24_APP_MIGRATION_DB_PASSWORD=

# Необязательные ссылки, добавляемые в задачи Битрикс24.
APP_SECTION_URL=
SUPPLY_SECTION_URL=
REPAIRS_SECTION_URL=

# Оповещения инвентаризации: off или on.
INVENTORY_NOTIFY=off

# Ответственный снабжения и склад прихода.
REPAIR_SUPPLY_RESPONSIBLE_ID=
SUPPLY_RECEIPT_STORE=Склад Прихода

# Только для служебных и исследовательских сценариев. Раскомментировать при необходимости.
# AUTOZADACHI_WEBHOOK=https://portal.example.bitrix24.ru/rest/...
# DEV_WEBHOOK=https://portal.example.bitrix24.ru/rest/...
# CATALOG_WRITE_WEBHOOK=https://portal.example.bitrix24.ru/rest/...
