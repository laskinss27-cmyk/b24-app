# Образец /root/sync/.env для резервного копирования и ручных служебных скриптов.
# Это не конфигурация регулярного синка остатков: ERPNext уже является источником склада.

# Вебхук используется core-backup-disk.ts для отправки дампа БД на Диск Битрикс24.
# DEV_WEBHOOK=https://umniydom.bitrix24.ru/rest/...

# Скрипты запускаются на хосте VPS, поэтому ERPNext доступен через loopback.
ERPNEXT_URL=http://127.0.0.1:8080
ERPNEXT_TOKEN=
