# Add only these values to a protected snapshot of the CURRENT backend environment.
# Do not replace its SQL/catalog/Tilda/ERP settings with a generic example file.
# This preparation stage keeps both receiver and CRM worker OFF.
UMNIYDOM_ORDERS_MODE=off
UMNIYDOM_ORDERS_PROCESSOR=off
UMNIYDOM_ORDERS_CHAT_ID=chat19572
UMNIYDOM_ORDERS_ROBOT_ID=2812
# Confirm existing lead stage NEW (Не обработан) and portal automation before setting.
UMNIYDOM_ORDERS_LEAD_STATUS=
# Actual sourceId from the existing website installation; never regenerate identity.
UMNIYDOM_ORDERS_SOURCE_ID=
# Generate a NEW shared secret through a protected channel; sandbox secret was discarded.
UMNIYDOM_ORDERS_SECRET=
# Absolute local persistent SQLite path under the confirmed /app/state mount.
UMNIYDOM_ORDERS_DB=
# Dedicated service-account webhook, not an employee fallback.
UMNIYDOM_ORDERS_CRM_WEBHOOK=
