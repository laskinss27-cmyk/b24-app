# Обезличенный образец закрытого env-файла backend.
# Заполнить на VPS. Реальные значения в Git не добавлять.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

PORTAL_DOMAIN=portal.example.bitrix24.ru
PUBLIC_BASE_URL=https://app.example.com

APP_CLIENT_ID=
APP_CLIENT_SECRET=
APP_SECRET=

# Имя frontend в Docker-сети ERPNext — это внутренний адрес, не публичный URL.
ERPNEXT_URL=http://frontend:8080
ERPNEXT_TOKEN=

# Отдельная workflow-БД пока отключена. Не менять до отдельного provision,
# backup/restore drill и явного разрешения на production rollout.
B24_APP_DB_MODE=off
B24_APP_CATALOG_SQL_READ=off
B24_APP_RESERVATIONS=off
# Для отдельного, явно разрешённого active-rollout. Эти credentials не должны
# совпадать с runtime reader, migrator, backfill или Tilda sync.
# B24_APP_RESERVATION_DB_USER=b24_app_reservation_runtime
# B24_APP_RESERVATION_DB_PASSWORD=
# B24_APP_RESERVATION_DB_CONNECTION_LIMIT=4
# Ручной owner-only shadow compare. Не включает SQL workflow reads или writes.
B24_APP_SUPPLY_SHADOW_COMPARE=off
# Проверенное чтение карточек перемещений из SQL. verified всё ещё сверяет
# живой Bitrix и автоматически оставляет его ответ при любом расхождении.
B24_APP_TRANSFER_SQL_READ=off
# Ручные заявки на перемещение/снабжение: shadow сравнивает, verified может
# вернуть SQL только при точном совпадении, primary читает SQL с Bitrix fallback.
B24_APP_TRANSFER_REQUEST_SQL_READ=off
# Shadow/primary writer использует тот же отдельный DML credential перемещений.
# primary разрешён только вместе с READ=primary после identity backfill.
B24_APP_TRANSFER_REQUEST_SQL_WRITE=off
# Теневая запись ревизий: Bitrix остаётся источником ответа, SQL получает ту же
# нормализованную версию после успешной записи. Только off|shadow.
B24_APP_INVENTORY_SQL_WRITE=off
# off | shadow | verified. Verified serves SQL only after exact live Bitrix parity.
B24_APP_INVENTORY_SQL_READ=off
# B24_APP_INVENTORY_DB_USER=b24_app_inventory_runtime
# B24_APP_INVENTORY_DB_PASSWORD=
# B24_APP_INVENTORY_DB_CONNECTION_LIMIT=2
# B24_APP_DB_HOST=<проверенное DNS-имя MariaDB в erpnext_frappe_network>
# B24_APP_DB_PORT=3306
# B24_APP_DB_NAME=b24_app
# B24_APP_DB_USER=b24_app_runtime
# B24_APP_DB_PASSWORD=
# B24_APP_DB_CONNECTION_LIMIT=4
# B24_APP_DB_CONNECT_TIMEOUT_MS=3000
# Migration credentials передаются только ручной команде и сюда не добавляются.

# Необязательные ссылки для задач. Числовые placement-ID могут меняться,
# поэтому поле лучше оставить пустым, чем хранить неподтверждённую ссылку.
APP_SECTION_URL=
SUPPLY_SECTION_URL=
REPAIRS_SECTION_URL=

INVENTORY_NOTIFY=off
REPAIR_SUPPLY_RESPONSIBLE_ID=
SUPPLY_RECEIPT_STORE=Склад Прихода

# Необязательный серверный вебхук. Не передаётся во frontend.
# AUTOZADACHI_WEBHOOK=https://portal.example.bitrix24.ru/rest/...
